    <bpmn:textAnnotation id="TextAnnotation_109astl">
      <bpmn:text>Reclassifies the case and loses months of case history (SN-104)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_14ypd5j" associationDirection="None" sourceRef="Event_1mcpfs2" targetRef="TextAnnotation_109astl" />
    <bpmn:textAnnotation id="TextAnnotation_09g0wzo">
      <bpmn:text>Duplicated work (SN-111)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_07m1aq4">
      <bpmn:text>No prioritisation system leading to misplaced time and effort (SN-077)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0e3jgge" associationDirection="None" sourceRef="Activity_04ihs3d" targetRef="TextAnnotation_07m1aq4" />
    <bpmn:textAnnotation id="TextAnnotation_1d5t2cn">
      <bpmn:text>Duplicated work, excessive time spent checking (SN-087)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0jajcgq" associationDirection="None" sourceRef="Activity_1i4bxf0" targetRef="TextAnnotation_1d5t2cn" />
    <bpmn:textAnnotation id="TextAnnotation_0urznj8">
      <bpmn:text>No prioritisation system leading to misplaced time and effort (SN-077)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_11gredt" associationDirection="None" sourceRef="TextAnnotation_0urznj8" targetRef="Activity_1rbn5z6" />
    <bpmn:textAnnotation id="TextAnnotation_0z7ijga">
      <bpmn:text>Inaccurate information wastes representative and customer time (SN-028)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_04xju7b" associationDirection="None" sourceRef="Flow_0hf5q1v" targetRef="TextAnnotation_0z7ijga" />
    <bpmn:association id="Association_0p343hh" associationDirection="None" sourceRef="TextAnnotation_0z7ijga" targetRef="Activity_065olxe" />
    <bpmn:textAnnotation id="TextAnnotation_0dejdm3">
      <bpmn:text>Double entry and duplicated work (SN-111)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1nevsqs" associationDirection="None" sourceRef="Activity_17eha4b" targetRef="TextAnnotation_0dejdm3" />
    <bpmn:textAnnotation id="TextAnnotation_0u5ng9r">
      <bpmn:text>Some representatives have their own workarounds and methods, leading to less up-to-date data, conflicting status terms, and harder onboarding (SN-122, SN-020)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0si7mmb" associationDirection="None" sourceRef="Activity_17eha4b" targetRef="TextAnnotation_0u5ng9r" />
    <bpmn:association id="Association_0btvmt8" associationDirection="None" sourceRef="Activity_1i4bxf0" targetRef="TextAnnotation_0u5ng9r" />
    <bpmn:textAnnotation id="TextAnnotation_0g4q9t6">
      <bpmn:text>Manual entry errors, and lack of enforcement leave promised follow-ups missed (SN-007, SN-053)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1cbvfvz" associationDirection="None" sourceRef="Activity_15j4p2t" targetRef="TextAnnotation_0g4q9t6" />
    <bpmn:textAnnotation id="TextAnnotation_0pljc3m">
      <bpmn:text>Cases lost due to lack of ownership in between-shift handoffs (&gt;20%) (SN-040 , SN-105)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1yl7y7r" associationDirection="None" sourceRef="Activity_15j4p2t" targetRef="TextAnnotation_0pljc3m" />
    <bpmn:textAnnotation id="TextAnnotation_097t3lx">
      <bpmn:text>No case separation means all prior representative time is wasted (SN-057)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_172dks1" associationDirection="None" sourceRef="Activity_1xy91du" targetRef="TextAnnotation_097t3lx" />
    <bpmn:textAnnotation id="TextAnnotation_024iwi3">
      <bpmn:text>Lost context in hand-offs forces customers to repeat stories (SN-036)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1rkn8zd" associationDirection="None" sourceRef="Activity_1xy91du" targetRef="TextAnnotation_024iwi3" />
    <bpmn:textAnnotation id="TextAnnotation_1evekt6">
      <bpmn:text>System treats promises to pay and payment confirmations the same (SN-112)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1g72xyh" associationDirection="None" sourceRef="Activity_17eha4b" targetRef="TextAnnotation_1evekt6" />
    <bpmn:textAnnotation id="TextAnnotation_1c769pw">
      <bpmn:text>Duplicated work, excessive time spent checking (SN-087)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0a8infh" associationDirection="None" sourceRef="TextAnnotation_1c769pw" targetRef="Activity_0vjdf3h" />
    <bpmn:textAnnotation id="TextAnnotation_0imqxbs">
      <bpmn:text>Double entry and duplicated work (SN-111)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04xq8d1">
      <bpmn:text>Manually logged promises to pay lead to data errors (SN-122)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1tdjehy" associationDirection="None" sourceRef="Activity_0zhfb44" targetRef="TextAnnotation_0imqxbs" />
    <bpmn:association id="Association_1y1modq" associationDirection="None" sourceRef="Activity_0zhfb44" targetRef="TextAnnotation_04xq8d1" />
    <bpmn:textAnnotation id="TextAnnotation_0z2dq2t">
      <bpmn:text>Entire process is duplicated work across multiple sources with poor visibility. (SN-111, SN-044, SN-008)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ffm9ih" associationDirection="None" sourceRef="Group_05bq0a1" targetRef="TextAnnotation_0z2dq2t" />
    <bpmn:textAnnotation id="TextAnnotation_0kt5eta">
      <bpmn:text>Unsuccessful contact not distinguished (SN-073)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1qxbu6v" associationDirection="None" sourceRef="Flow_0fpuihw" targetRef="TextAnnotation_0kt5eta" />
  </bpmn:collaboration>
